#!/bin/bash
# Bootstrap OdooClaw in a generated Doodba project (use_odooclaw=true).
#
# Populates ./odooclaw — the build context of the `odooclaw` compose service —
# with the gateway source of https://github.com/nicolasramos/odooclaw.
#
# Two things make a plain `git clone ... ./odooclaw` impossible:
#   1. the project already ships ./odooclaw/config/config.json (generated by
#      copier), so the directory exists and is not empty;
#   2. the gateway lives in the repository's *inner* `odooclaw/` sub-tree — the
#      repo root has no `docker/`, while compose builds with
#      `context: ./odooclaw` + `dockerfile: docker/Dockerfile`.
# So we clone into a temp dir and copy that sub-tree over, preserving the
# generated config. Same approach as odooclaw's own scripts/install_doodba.sh.
#
# Safe to re-run (no-op once bootstrapped); pass --refresh to re-sync.
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ODOOCLAW_DIR="$PROJECT_ROOT/odooclaw"
ODOOCLAW_REPO="https://github.com/nicolasramos/odooclaw.git"
GENERATED_CONFIG="$ODOOCLAW_DIR/config/config.json"
TMP_DIR=""

cleanup() {
    [ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR"
    return 0
}
trap cleanup EXIT

fetch_gateway_source() {
    TMP_DIR="$(mktemp -d)"
    echo ">> Cloning OdooClaw gateway source (temporary checkout) ..."
    git clone --depth 1 "$ODOOCLAW_REPO" "$TMP_DIR/repo"

    local src="$TMP_DIR/repo/odooclaw"
    if [ ! -f "$src/docker/Dockerfile" ] || [ ! -f "$src/go.mod" ]; then
        echo "!! Unexpected layout in $ODOOCLAW_REPO." >&2
        echo "   Expected the gateway in its inner odooclaw/ sub-tree with" >&2
        echo "   odooclaw/docker/Dockerfile (what compose builds)." >&2
        exit 1
    fi

    # Never clobber the copier-generated gateway config.
    local saved_config=""
    if [ -f "$GENERATED_CONFIG" ]; then
        saved_config="$(mktemp)"
        cp "$GENERATED_CONFIG" "$saved_config"
    fi

    echo ">> Copying the gateway sub-tree into $ODOOCLAW_DIR ..."
    mkdir -p "$ODOOCLAW_DIR"
    if command -v rsync >/dev/null 2>&1; then
        rsync -a --exclude='config/config.json' "$src/" "$ODOOCLAW_DIR/"
    else
        cp -R "$src/." "$ODOOCLAW_DIR/"
    fi

    if [ -n "$saved_config" ]; then
        mkdir -p "$(dirname "$GENERATED_CONFIG")"
        cp "$saved_config" "$GENERATED_CONFIG"
        rm -f "$saved_config"
    fi
    # Drop the temporary checkout right away: clearing TMP_DIR without removing
    # it would disarm the EXIT trap (cleanup() skips an empty variable) and
    # leak the whole gateway clone (~70 MB) on every bootstrap.
    rm -rf "$TMP_DIR"
    TMP_DIR=""
}

if [ "${1:-}" = "--refresh" ] \
    || [ ! -f "$ODOOCLAW_DIR/go.mod" ] \
    || [ ! -f "$ODOOCLAW_DIR/docker/Dockerfile" ]; then
    fetch_gateway_source
else
    echo ">> Gateway source already present in $ODOOCLAW_DIR (pass --refresh to re-sync)."
fi

# Fail loudly instead of letting `docker compose build odooclaw` die later.
if [ ! -f "$ODOOCLAW_DIR/docker/Dockerfile" ]; then
    echo "!! $ODOOCLAW_DIR/docker/Dockerfile not found." >&2
    echo "   The odooclaw service builds with context ./odooclaw and" >&2
    echo "   dockerfile docker/Dockerfile; re-run this script." >&2
    exit 1
fi

if [ ! -f "$GENERATED_CONFIG" ]; then
    echo "!! odooclaw/config/config.json is missing. Re-run 'copier copy' or restore it." >&2
    exit 1
fi

# .docker/odooclaw.env is read verbatim by compose `env_file`: any ${...} in it
# is interpolated from your shell / the project .env, never from the file
# itself, so the values have to be written in directly.
ENV_FILE="$PROJECT_ROOT/.docker/odooclaw.env"
if [ -f "$ENV_FILE" ] && ! grep -qE '^ODOOCLAW_PROVIDERS_[A-Z]+_API_KEY=.+' "$ENV_FILE"; then
    echo ">> WARNING: no provider API key set in .docker/odooclaw.env."
    echo "   Edit that file and paste your key after ODOOCLAW_PROVIDERS_*_API_KEY=."
fi

echo ""
echo "OdooClaw bootstrap completed."
echo "Next steps:"
echo "  1) Fill .docker/odooclaw.env: your provider API key and the Odoo"
echo "     technical-user credentials (ODOO_USERNAME / ODOO_PASSWORD)."
echo "     Values are read as-is: write them literally, never as \${VAR} references."
echo "  2) Build and start: docker compose -f devel.yaml build odooclaw && docker compose -f devel.yaml up -d"
echo "  3) Install the mail_bot_odooclaw module in Odoo (Apps -> search 'OdooClaw')."
echo "  4) Verify: scripts/smoke-test-odooclaw.sh"
